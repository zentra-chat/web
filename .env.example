# Default instance information that the site wil connect to by default
PUBLIC_DEFAULT_INSTANCE_URL=http://localhost:8080
PUBLIC_DEFAULT_INSTANCE_NAME=Zentra Local

# Optional Turnstile site key for bot protection on registration and login.
PUBLIC_TURNSTILE_SITE_KEY=

# Optional local path to @zentra-chat/plugin-sdk for development.
# Example: ../plugin-sdk
ZENTRA_PLUGIN_SDK_PATH=
